# Copy to .env.local to change defaults. Nothing here is required.

# KeepTradeCut has no official API; its adapter scrapes the public rankings page.
# Off by default. Check KTC's terms of use before enabling it or deploying with it.
ENABLE_KTC=false

# Local JSON file cache in .cache/ (always off on Vercel). Set to 0 to disable locally.
FILE_CACHE=1

# RosterAudit: off by default. Its terms allow personal tools but forbid services that
# compete with it (it runs its own trade calculator), so leave this off for a public site.
ENABLE_ROSTERAUDIT=false

# Turn off sources that are on by default (comma-separated IDs):
# fantasycalc, dynastyprocess, dynastydealer.
DISABLE_SOURCES=
